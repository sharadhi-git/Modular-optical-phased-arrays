Cell[TextData[{
 StyleBox["For same R",
  FontFamily->"Source Sans Pro",
  FontSize->16],
 StyleBox["1",
  FontFamily->"Source Sans Pro"],
 StyleBox[" and R2 receivers locations, below loop generates cluster \
excitation pattern and corresponding PSLL and MMPR for varying cluster \
activation count from 6 to 40. As a result, completing the loop will take a \
considerable amount of time.",
  FontFamily->"Source Sans Pro",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.947627262171065*^9, 
  3.9476272847211046`*^9}},ExpressionUUID->"a08a5c51-2980-4780-ac86-\
ee371ae1d6d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"clusterExcitationPatternGenSA", "[", 
    RowBox[{"mMin_", ",", "mMax_", ",", "userLocation_", ",", "weightCom_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"results", "=", 
        RowBox[{"{", "}"}]}], ",", "clusterExcitationPatternSA", ",", 
       RowBox[{"thinnedClusterRadiationXY", "=", "0"}], ",", 
       RowBox[{"datapairMax", "=", "0"}], ",", 
       RowBox[{"lsllResult", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"userPowerList", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "mMin"}], ",", 
        RowBox[{"i", "<=", "mMax"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"clusterExcitationPatternSA", "=", 
          RowBox[{"clusterThinningSAAlgo", "[", 
           RowBox[{"userLocation", ",", "i", ",", "weightCom"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"thinnedClusterRadiationXY", "=", 
          RowBox[{"Abs", "[", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"beamFocusingPatternPlanar", "[", 
               RowBox[{
               "\[Lambda]d", ",", "\[Lambda]e", ",", "x", ",", "y", ",", 
                "0.75", ",", "Dis1", ",", "dis1", ",", "mx1", ",", "my1", ",",
                 "nx1", ",", "ny1", ",", "xMiddle", ",", "yMiddle", ",", 
                "userLocation"}], "]"}], "*", "clusterExcitationPatternSA"}], 
             ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"datapairMax", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{"thinnedClusterRadiationXY", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "xLength", ",", "0.1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", "0", ",", "yLength", ",", "0.1"}], "}"}]}], 
            "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"lsllResult", "=", 
          RowBox[{"findPlanarSLL", "[", 
           RowBox[{
           "userLocation", ",", "datapairMax", ",", 
            "clusterExcitationPatternSA"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"userPowerList", "=", 
          RowBox[{"beamPowerForUsers", "[", 
           RowBox[{"thinnedClusterRadiationXY", ",", "userLocation", ",", 
            RowBox[{"10", "*", 
             SuperscriptBox["10", 
              RowBox[{"-", "3"}]]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"results", ",", 
           RowBox[{"{", 
            RowBox[{
            "clusterExcitationPatternSA", ",", "lsllResult", ",", 
             "userPowerList"}], "}"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "results"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
