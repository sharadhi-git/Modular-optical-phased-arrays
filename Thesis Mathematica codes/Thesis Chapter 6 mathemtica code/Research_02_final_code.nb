Cell[BoxData[
 RowBox[{
  RowBox[{"selectValidSubMatrixDimension", "[", 
   RowBox[{
   "matrixRowCount_", ",", "matrixColCount_", ",", "subMatrixCount_"}], "]"}],
   ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "totalElems", ",", "subMatrixSize", ",", "possibleRowDimensions", ",", 
      "r", ",", "c", ",", "validDimensions", ",", "mostSquareDimension"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"totalElems", "=", 
       RowBox[{"matrixRowCount", "*", "matrixColCount"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"subMatrixSize", "=", 
       RowBox[{"totalElems", "/", "subMatrixCount"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Find", " ", "possible", " ", "Row", " ", "dimensions", " ", "for", " ",
         "the", " ", "calculated", " ", "submaitrxSize"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"possibleRowDimensions", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Divisors", "[", "subMatrixSize", "]"}], ",", 
         RowBox[{
          RowBox[{"Divisible", "[", 
           RowBox[{"matrixRowCount", ",", "#"}], "]"}], "&"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "find", " ", "matching", " ", "Column", " ", "Size", " ", "for", " ", 
        "the", " ", "Possible", " ", "Row", " ", "Dimensions", " ", "and", " ",
         "then", " ", "select", " ", "possible", " ", "couples", " ", "which",
         " ", "can", " ", "accomadate", " ", "subMatrix", " ", "by", " ", 
        "finindg", " ", "correct", " ", "column", " ", "sizes"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"validDimensions", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"r", ",", 
             RowBox[{"c", "=", 
              RowBox[{"subMatrixSize", "/", "r"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "possibleRowDimensions"}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"Divisible", "[", 
           RowBox[{"matrixColCount", ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Select", " ", "MSot", " ", "squarer", " ", "pairs", " ", "and", " ", 
        "if", " ", "there", " ", "are", " ", "tow", " ", "select", " ", "low",
         " ", "row", " ", "count", " ", "with", " ", "high", " ", "col", " ", 
        "count"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"mostSquareDimension", "=", 
       RowBox[{"MinimalBy", "[", 
        RowBox[{"validDimensions", ",", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}]}], "]"}]}], ";"}],
      "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "mostSquareDimension", "]"}], ">=", "1"}], ",",
         " ", 
        RowBox[{"Return", "[", 
         RowBox[{"mostSquareDimension", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
        RowBox[{"Return", "[", "mostSquareDimension", "]"}]}], "]"}], "*)"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"mostSquareDimension", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.939228253379835*^9, 3.9476091885018244`*^9, {3.9479025724628906`*^9, 
   3.947902576106038*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"295bc97b-2be1-4fd8-be90-723d4059e291"],

Cell[BoxData[
 RowBox[{
  RowBox[{"subdividingMatrix", "[", 
   RowBox[{"uElems_", ",", "vElems_", ",", "userCount_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "factors", ",", "nearestFactor", ",", "subMatrixDimension", ",", 
      "matrix", ",", "r", ",", "c", ",", "u", ",", "v", ",", "m", ",", "n"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"factors", "=", 
      RowBox[{"Divisors", "[", 
       RowBox[{"uElems", "*", "vElems"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Finding", " ", "nearest", " ", "factor", " ", "for", " ", "the", " ", 
       "given", " ", "number", " ", "of", " ", "users"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"nearestFactor", "=", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{"factors", ",", 
        RowBox[{
         RowBox[{"#", ">=", "userCount"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Find", " ", "the", " ", "best", " ", "submatrix", " ", "dimension", " ",
        "for", " ", "the", " ", "given", " ", "number", " ", "of", " ", 
       "users"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"subMatrixDimension", "=", 
      RowBox[{"selectValidSubMatrixDimension", "[", 
       RowBox[{"uElems", ",", "vElems", ",", "nearestFactor"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "subMatrixDimension"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.939228253379835*^9, 3.9476091885018244`*^9, {3.947902579872229*^9, 
   3.9479025878385706`*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"d08478e3-bf74-48fa-b332-95028c860983"],

Cell[TextData[StyleBox["Define the multi-beam focusing pattern with dual \
carrier framework",
 FontFamily->"Source Sans Pro",
 FontSize->16,
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{{3.9476086046528015`*^9, 3.9476086680258274`*^9}, 
   3.9476091885018244`*^9},ExpressionUUID->"778b3df6-c2b3-404b-bb3d-\
be34339f0285"],

Cell[BoxData[
 RowBox[{
  RowBox[{"beamFocusingPatternPlanar", "[", 
   RowBox[{
   "\[Lambda]d_", " ", ",", "\[Lambda]e_", ",", "x_", ",", "y_", ",", "z_", ",",
     "Dis_", ",", "dis_", ",", "mxClus_", ",", "myClus_", ",", "nxElems_", ",",
     "nyElems_", ",", "xMid_", ",", "yMid_", ",", "focalPoints_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "arbitraryPoint", ",", "elementPoint", ",", "nx", ",", "ny", ",", "mx", ",",
       "my", ",", "clusterMidPoint", ",", "rt", ",", "rp", ",", 
      "focalPointCount", ",", "subMatrixDim", ",", "r", ",", "c", ",", "m", ",",
       "n", ",", "assignedSubMatrices", ",", "beamFocusingPlanarCluster", ",",
       "rpI", ",", "deltaArrI"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"arbitraryPoint", "=", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"elementPoint", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xMid", "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox["dis", "2"], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "*", "nx"}], "-", "nxElems", "-", "1"}], ")"}]}], "+", 
           RowBox[{
            FractionBox["Dis", "2"], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "*", "mx"}], "-", "mxClus", "-", "1"}], ")"}]}]}], 
          ")"}]}], ",", 
        RowBox[{"yMid", "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox["dis", "2"], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "*", "ny"}], "-", "nyElems", "-", "1"}], ")"}]}], "+", 
           RowBox[{
            FractionBox["Dis", "2"], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "*", "my"}], "-", "myClus", "-", "1"}], ")"}]}]}], 
          ")"}]}], ",", "zHeight"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"clusterMidPoint", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xMid", "+", 
         RowBox[{
          FractionBox["Dis", "2"], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "mx"}], "-", "mxClus", "-", "1"}], ")"}]}]}], ",", 
        RowBox[{"yMid", "+", 
         RowBox[{
          FractionBox["Dis", "2"], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "my"}], "-", "myClus", "-", "1"}], ")"}]}]}], ",",
         "zHeight"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rt", "=", 
      RowBox[{"EuclideanDistance", "[", 
       RowBox[{"arbitraryPoint", ",", "clusterMidPoint"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rp", "=", 
      RowBox[{"EuclideanDistance", "[", 
       RowBox[{"arbitraryPoint", ",", "elementPoint"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"focalPointCount", "=", 
      RowBox[{"Length", "[", "focalPoints", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"subMatrixDim", "=", 
      RowBox[{"subdividingMatrix", "[", 
       RowBox[{"nxElems", ",", "nyElems", ",", "focalPointCount"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"subMatrixDim", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"subMatrixDim", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"assignedSubMatrices", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"beamFocusingPlanarCluster", "=", "0"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"m", "=", "1"}], ",", 
       RowBox[{"m", "<=", "nxElems"}], ",", 
       RowBox[{"m", "+=", "r"}], ",", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"n", "=", "1"}], ",", 
          RowBox[{"n", "<=", "nyElems"}], ",", 
          RowBox[{"n", "+=", "c"}], ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"assignedSubMatrices", ">", "focalPointCount"}], ",", 
              RowBox[{"Break", "[", "]"}], ","}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"rpI", "=", 
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{
               RowBox[{"focalPoints", "[", 
                RowBox[{"[", "assignedSubMatrices", "]"}], "]"}], ",", 
               "elementPoint"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"deltaArrI", "=", 
             RowBox[{"rp", "-", "rpI"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"beamFocusingPlanarCluster", "+=", 
             RowBox[{
              UnderoverscriptBox["\[Sum]", 
               RowBox[{"nx", "=", "m"}], 
               RowBox[{"m", "+", "r", "-", "1"}]], 
              RowBox[{
               UnderoverscriptBox["\[Sum]", 
                RowBox[{"ny", "=", "n"}], 
                RowBox[{"n", "+", "c", "-", "1"}]], 
               FractionBox[
                RowBox[{
                 RowBox[{"Cos", "[", 
                  RowBox[{
                   FractionBox[
                    RowBox[{"2", "\[Pi]"}], "\[Lambda]e"], "*", "deltaArrI"}],
                   "]"}], "*", 
                 RowBox[{"Exp", "[", 
                  RowBox[{
                   RowBox[{"-", "\[ImaginaryI]"}], "*", 
                   FractionBox[
                    RowBox[{"2", "\[Pi]"}], "\[Lambda]d"], "*", "deltaArrI"}],
                   "]"}]}], "rt"]}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"assignedSubMatrices", "++"}], ";"}], 
           "\[IndentingNewLine]", "}"}]}], "]"}], "\[IndentingNewLine]", 
        "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{"beamFocusingPlanarCluster", ",", 
       RowBox[{"{", 
        RowBox[{"mx", ",", "1", ",", "mxClus"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"my", ",", "1", ",", "myClus"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.938450897338875*^9, 3.938450902083892*^9}, 
   3.939228253379835*^9, {3.9432871282895937`*^9, 3.943287348628195*^9}, {
   3.9432873796138844`*^9, 3.9432873891184855`*^9}, {3.943287423332493*^9, 
   3.943287436899124*^9}, 3.9476091885018244`*^9, {3.947902611216399*^9, 
   3.947902634689372*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"ccbfd522-1f7c-4354-a8ad-1fb41f750e05"],

