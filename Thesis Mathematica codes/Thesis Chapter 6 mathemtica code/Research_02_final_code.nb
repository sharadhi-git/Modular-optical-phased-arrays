Cell[CellGroupData[{

Cell[TextData[StyleBox["Evaluating Max-Min Power Ratio (MMPR) in a \
Two-Receiver System Under Varying Detector Area.",
 FontFamily->"Source Sans Pro SemiBold",
 FontSize->18,
 FontWeight->"SemiBold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.5019607843137255, 0., 0.]]], "Subsubsection",
 CellChangeTimes->{{3.9476119323875723`*^9, 3.947611970589409*^9}, {
  3.94761247718299*^9, 
  3.9476125200688314`*^9}},ExpressionUUID->"e64ed436-67c2-4143-ae96-\
16ceb78b43af"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"beamPower", "[", 
    RowBox[{"config_", ",", "userlocation_", ",", "detectorArea_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x0", ",", "x1", ",", "y0", ",", "y1", ",", "beamPower", ",", 
       RowBox[{"\[Eta]", "=", "377"}], ",", 
       RowBox[{"\[Alpha]", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"x0", "=", 
       RowBox[{
        RowBox[{"userlocation", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        FractionBox["detectorArea", "2"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x1", "=", 
       RowBox[{
        RowBox[{"userlocation", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "+", 
        FractionBox["detectorArea", "2"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"y0", "=", 
       RowBox[{
        RowBox[{"userlocation", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        FractionBox["detectorArea", "2"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"y1", "=", 
       RowBox[{
        RowBox[{"userlocation", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "+", 
        FractionBox["detectorArea", "2"]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"beamPower", "=", 
       RowBox[{
        FractionBox["\[Alpha]", 
         RowBox[{"2", "*", "\[Eta]"}]], "*", 
        RowBox[{"Quiet", "[", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", "config", ")"}], "2"], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "x0", ",", "x1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "y0", ",", "y1"}], "}"}]}], "]"}], 
         "]"}]}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.944757772935935*^9, 3.9447578118063517`*^9}, {
   3.94475786144545*^9, 3.9447578932684298`*^9}, 3.94502570601587*^9, {
   3.9459985738038034`*^9, 3.945998585134823*^9}, {3.945999272730451*^9, 
