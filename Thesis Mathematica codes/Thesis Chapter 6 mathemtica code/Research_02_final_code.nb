Cell[CellGroupData[{

Cell[TextData[StyleBox["Normalized beam focusing pattern for 2 receivers: \
figure 06",
 FontFamily->"Source Sans Pro SemiBold",
 FontSize->18,
 FontWeight->"SemiBold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.5019607843137255, 0., 0.]]], "Subsubsection",
 CellChangeTimes->{{3.9389941595281086`*^9, 3.938994195191*^9}, 
   3.939228253382835*^9, 3.947609188512883*^9, 3.947610445874995*^9, {
   3.9476108247569804`*^9, 
   3.9476108974996834`*^9}},ExpressionUUID->"0e62e32e-57e1-4a09-88f5-\
b884ce5b743a"],

Cell[TextData[StyleBox["Plotting the normalized beam focusing  patterns",
 FontFamily->"Source Sans Pro",
 FontSize->16,
 FontSlant->"Italic"]], "Text",
 CellChangeTimes->{
  3.70999648737139*^9, {3.9476109779219985`*^9, 3.947611005212492*^9}, {
   3.9476111343448114`*^9, 
   3.9476111415700817`*^9}},ExpressionUUID->"77c5fb93-94cb-4356-b6e2-\
a902148e4361"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotRadiationY", "[", 
   RowBox[{
   "dataPair_", ",", "yMin_", ",", "yMax_", ",", "axisLabel_", ",", 
    "location_", ",", "user_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"labelSpot", ",", "specialTick", ",", "normalizedPlot"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"axisLabel", "==", "\"\<y-axis (m)\>\""}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"specialTick", "=", 
          RowBox[{"location", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"location", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">=", "2.5"}], ",", 
           RowBox[{"labelSpot", "=", 
            RowBox[{"{", 
             RowBox[{"0.7", ",", "0.9"}], "}"}]}], ",", 
           RowBox[{"labelSpot", "=", 
            RowBox[{"{", 
             RowBox[{"3.3", ",", "0.9"}], "}"}]}]}], "]"}]}], "}"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"specialTick", "=", 
          RowBox[{"location", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"location", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">=", "2.5"}], ",", 
           RowBox[{"labelSpot", "=", 
            RowBox[{"{", 
             RowBox[{"0.7", ",", "0.9"}], "}"}]}], ",", 
           RowBox[{"labelSpot", "=", 
            RowBox[{"{", 
             RowBox[{"2.5", ",", "0.9"}], "}"}]}]}], "]"}]}], "}"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"normalizedPlot", "=", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{"dataPair", ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"yMin", ",", "yMax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"AxesOrigin", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], ",", 
        RowBox[{"Frame", "->", 
         RowBox[{"{", 
          RowBox[{
