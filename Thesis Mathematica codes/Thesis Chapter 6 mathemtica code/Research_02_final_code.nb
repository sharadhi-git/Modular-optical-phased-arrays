Cell[CellGroupData[{

Cell[TextData[StyleBox["Evaluating the Pareto Optimal behaviour for 3 \
objectives on different weight combinations",
 FontFamily->"Source Sans Pro SemiBold",
 FontSize->18,
 FontWeight->"SemiBold",
 FontSlant->"Italic",
 FontColor->RGBColor[0.5019607843137255, 0., 0.]]], "Subsubsection",
 CellChangeTimes->{{3.9476178533105564`*^9, 3.94761787976995*^9}, {
  3.947617990403715*^9, 
  3.947618006932476*^9}},ExpressionUUID->"81fddeec-479a-4adb-9117-\
c7bbc1195679"],

Cell[TextData[StyleBox["This for loop generates the objective space for 60 \
different weight combinations when only 18 IR radiative clusters are active. \
In each iteration, it computes the selective excitation pattern using the \
sparse-relaxation based weighted sum algorithm defined above. As a result, \
completing the loop will take a considerable amount of time.",
 FontFamily->"Source Sans Pro",
 FontSize->16]], "Text",
 CellChangeTimes->{
  3.70999648737139*^9, {3.9476187242021456`*^9, 3.9476187363769617`*^9}, {
   3.9476188396172266`*^9, 3.947618956934713*^9}, {3.947618995246741*^9, 
   3.9476190179601564`*^9}, {3.9476190706686764`*^9, 
   3.947619084115907*^9}},ExpressionUUID->"5fc88f5a-3d9b-443f-9655-\
536c5cc6cf40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"onClusters", "=", "18"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"On", " ", "cluster", " ", "count"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nCount", "=", "10"}], ";", 
  RowBox[{"dataList", "=", 
   RowBox[{"{", "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.70999648737139*^9, {3.9476190528361473`*^9, 3.947619053233179*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"441feaec-9a41-4526-9c8f-8d43060c9cd2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "0"}], ",", 
    RowBox[{"i", "<=", "nCount"}], ",", 
    RowBox[{"i", "++"}], " ", ",", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "0"}], ",", 
      RowBox[{"j", "<=", 
       RowBox[{"(", 
        RowBox[{"nCount", "-", "i"}], ")"}]}], ",", 
      RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"k", "=", 
         RowBox[{"nCount", "-", "i", "-", "j"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"weightCombination", "=", 
         RowBox[{"{", 
          RowBox[{
           FractionBox["i", "nCount"], ",", 
           FractionBox["j", "nCount"], ",", 
           FractionBox["k", "nCount"]}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"clusterThinningAlgo", "[", 
          RowBox[{
          "userLocations2", ",", "onClusters", ",", "weightCombination"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"dataList", ",", 
          RowBox[{"{", 
           RowBox[{"weightCombination", ",", 
            RowBox[{"result", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"result", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", 
            RowBox[{"result", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.943383917571213*^9, 3.943383929812913*^9}, {
