    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"weights", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1", ",", 
         RowBox[{"mx1", "*", "my1"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
