  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"radiationAtUseri", "=", 
       RowBox[{"{", "}"}]}], ",", "i", ",", "j", ",", 
