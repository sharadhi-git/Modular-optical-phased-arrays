      RowBox[{"radiationListForUsers", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"modRadiationListForUsers", "=", 
       RowBox[{"{", "}"}]}], ",", "i", ",", "val", ",", 
      RowBox[{"valSet", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"xyList", "=", 
       RowBox[{"{", "}"}]}], ",", "radiationData", ",", 
      RowBox[{"sllDataSet", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"sllData", "=", "0"}], ",", 
      RowBox[{"objectiveFunction", "=", "0"}], ",", "binaryVars", ",", 
      "initialGuess", ",", "thresholdIntensityL", ",", "thresholdIntensityU", 
      ",", 
      RowBox[{"mMin", "=", "6"}], ",", 
      RowBox[{"mMax", "=", "40"}], ",", "constraints", ",", "solution"}], 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "userLocations", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"radiationListForUsers", "=", 
         RowBox[{"beamFocusingPatternPlanar", "[", 
          RowBox[{"\[Lambda]d", ",", "\[Lambda]e", ",", 
           RowBox[{"userLocations", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"userLocations", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "0.75", ",", "Dis1", 
           ",", "dis1", ",", "mx1", ",", "my1", ",", "nx1", ",", "ny1", ",", 
           "xMiddle", ",", "yMiddle", ",", "userLocations"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"modRadiationListForUsers", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"radiationListForUsers", ",", "1"}], "]"}]}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"binaryVars", "=", 
      RowBox[{"Array", "[", 
       RowBox[{"b", ",", 
        RowBox[{"mx1", "*", "my1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"initialGuess", "=", 
      RowBox[{"RandomInteger", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"Length", "[", "binaryVars", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "userLocations", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"val", "=", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"modRadiationListForUsers", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ".", "binaryVars"}], "]"}], 
            ")"}], "2"]}], ",", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"valSet", ",", "val"}], "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "userLocations", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xyList", "=", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", ",", "y"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", 
                 RowBox[{
                  RowBox[{"userLocations", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "-", "0.5"}], ",", 
                 RowBox[{
                  RowBox[{"userLocations", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "+", "0.5"}], ",", 
                 "0.05"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", 
                 RowBox[{
                  RowBox[{"userLocations", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", "0.5"}], ",", 
                 RowBox[{
                  RowBox[{"userLocations", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "+", "0.5"}], ",", 
                 "0.05"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"userLocations", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "-", "0.005"}], "<=",
                 "x", "<=", " ", 
                RowBox[{
                 RowBox[{"userLocations", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "+", "0.005"}]}], 
               ")"}], " ", "&&", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"userLocations", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", "0.005"}], "<=",
                 "y", "<=", " ", 
                RowBox[{
                 RowBox[{"userLocations", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "+", "0.005"}]}], 
               ")"}]}], ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"radiationData", " ", "=", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"beamFocusingPatternPlanar", "[", 
              RowBox[{"\[Lambda]d", ",", "\[Lambda]e", ",", 
               RowBox[{"xyList", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", 
               RowBox[{"xyList", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "2"}], "]"}], "]"}], ",", "0.75", ",", 
               "Dis1", ",", "dis1", ",", "mx1", ",", "my1", ",", "nx1", ",", 
               "ny1", ",", "xMiddle", ",", "yMiddle", ",", "userLocations"}], 
              "]"}], ",", "1"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "[", "xyList", "]"}]}], "}"}]}], "]"}]}], ";", 
        " ", "\[IndentingNewLine]", 
        RowBox[{"sllData", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"radiationData", ".", "binaryVars"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"sllDataSet", ",", "sllData"}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], " ", ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"objectiveFunction", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"weightCom", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "*", 
        RowBox[{"Mean", "[", "valSet", "]"}]}], "-", 
       RowBox[{
        RowBox[{"weightCom", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "*", 
        RowBox[{"StandardDeviation", "[", "valSet", "]"}]}], "-", 
       RowBox[{
        RowBox[{"weightCom", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "*", 
        RowBox[{"Max", "[", "sllDataSet", "]"}]}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Objective", " ", "statement"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"thresholdIntensityL", "=", 
      RowBox[{"0.9", "*", 
       FractionBox["1", 
        RowBox[{"Length", "[", "userLocations", "]"}]], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"mMin", "*", "nx1", "*", "ny1"}], 
          RowBox[{"EuclideanDistance", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"xMiddle", ",", "yMiddle", ",", "zHeight"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"xLength", ",", "yLength", ",", "0"}], "}"}]}], "]"}]], 
         ")"}], "2"]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Lower", " ", "intensity", " ", "limit"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"thresholdIntensityU", "=", 
      RowBox[{"1.1", "*", 
       FractionBox["1", 
        RowBox[{"Length", "[", "userLocations", "]"}]], "*", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"mMax", "*", "nx1", "*", "ny1"}], 
          RowBox[{"EuclideanDistance", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"xMiddle", ",", "yMiddle", ",", "zHeight"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"xMiddle", ",", "yMiddle", ",", "0"}], "}"}]}], "]"}]], 
         ")"}], "2"]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"Upper", " ", "intensity", " ", "limit"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"constraints", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"0", "<=", "binaryVars", "<=", "1"}], ",", 
        RowBox[{"binaryVars", "\[Element]", "Integers"}], ",", 
        RowBox[{
         RowBox[{"Total", "[", "binaryVars", "]"}], "==", "onCount"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"thresholdIntensityL", "<=", 
           RowBox[{"valSet", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "<=", "thresholdIntensityU"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "userLocations", "]"}]}], "}"}]}], "]"}]}],
        "}"}]}], ";", 
     RowBox[{"(*", "Constraints", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"solution", "=", 
      RowBox[{"NMaximize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"objectiveFunction", ",", "constraints"}], "}"}], ",", 
        "binaryVars", ",", 
        RowBox[{"Method", "->", "\"\<SimulatedAnnealing\>\""}]}], "]"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Return", " ", "the", " ", "solution"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Values", "[", 
        RowBox[{"solution", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"mx1", ",", "my1"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
