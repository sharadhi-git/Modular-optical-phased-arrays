Cell[TextData[{
 StyleBox["For same R",
  FontFamily->"Source Sans Pro",
  FontSize->16],
 StyleBox["1",
  FontFamily->"Source Sans Pro"],
 StyleBox[" and R2 receivers locations, This loop generates cluster \
excitation pattern and corresponding PSLL and MMPR for varying cluster \
activation count from 6 to 40. As a result, completing the loop will take a \
considerable amount of time.",
  FontFamily->"Source Sans Pro",
  FontSize->16]
}], "Text",
 CellChangeTimes->{
  3.70999648737139*^9, {3.945965241626527*^9, 3.945965246548252*^9}, {
   3.947623267861208*^9, 3.9476234068289576`*^9}, {3.947623461906433*^9, 
   3.947623482115266*^9}},ExpressionUUID->"23d2c49b-fc24-4c50-9ff7-\
dffbfccf574b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"clusterExcitationPatternGen", "[", 
    RowBox[{"mMin_", ",", "mMax_", ",", "userLocation_", ",", "weightCom_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"results", "=", 
        RowBox[{"{", "}"}]}], ",", "clusterExcitationPatterncX", ",", 
       "thinnedClusterRadiationXY", ",", "datapairMax", ",", 
       RowBox[{"lsllResult", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"userPowerList", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "mMin"}], ",", 
        RowBox[{"i", "<=", "mMax"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"clusterExcitationPatterncX", "=", 
          RowBox[{
           RowBox[{"clusterThinningAlgo", "[", 
            RowBox[{"userLocation", ",", "i", ",", "weightCom"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"thinnedClusterRadiationXY", "=", 
          RowBox[{"Abs", "[", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"beamFocusingPatternPlanar", "[", 
               RowBox[{
               "\[Lambda]d", ",", "\[Lambda]e", ",", "x", ",", "y", ",", 
                "0.75", ",", "Dis1", ",", "dis1", ",", "mx1", ",", "my1", ",",
                 "nx1", ",", "ny1", ",", "xMiddle", ",", "yMiddle", ",", 
                "userLocation"}], "]"}], "*", "clusterExcitationPatterncX"}], 
             ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"datapairMax", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{"thinnedClusterRadiationXY", ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "xLength", ",", "0.1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", "0", ",", "yLength", ",", "0.1"}], "}"}]}], 
            "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"lsllResult", "=", 
          RowBox[{"findPlanarSLL", "[", 
           RowBox[{
           "userLocation", ",", "datapairMax", ",", 
            "clusterExcitationPatterncX"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"userPowerList", "=", 
          RowBox[{"beamPowerForUsers", "[", 
           RowBox[{"thinnedClusterRadiationXY", ",", "userLocation", ",", 
            RowBox[{"10", "*", 
             SuperscriptBox["10", 
              RowBox[{"-", "3"}]]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"results", ",", 
           RowBox[{"{", 
            RowBox[{
            "clusterExcitationPatterncX", ",", "lsllResult", ",", 
             "userPowerList"}], "}"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "results"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9451260212920775`*^9, 3.9451263154345455`*^9}, {
  3.945126370187393*^9, 3.945126386999256*^9}},
 CellLabel->
  "In[138]:=",ExpressionUUID->"1be31483-9e00-443e-aa2c-5def738340cb"],

