Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"beamPowerForUsers", "[", 
    RowBox[{"config_", ",", "userLocations_", ",", "detectorArea_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"beamPrList", "=", 
        RowBox[{"{", "}"}]}], ",", "j", ",", "beamPr"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", "1"}], ",", 
        RowBox[{"j", "<=", 
         RowBox[{"Length", "[", "userLocations", "]"}]}], ",", 
        RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"beamPr", "=", 
          RowBox[{"beamPower", "[", 
           RowBox[{"config", ",", 
            RowBox[{"userLocations", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", "detectorArea"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"beamPrList", ",", "beamPr"}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "beamPrList"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.70999648737139*^9, {3.9459983590400352`*^9, 3.9459984848668156`*^9}, {
