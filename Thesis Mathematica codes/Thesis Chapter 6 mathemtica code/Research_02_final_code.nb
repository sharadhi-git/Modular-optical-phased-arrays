      "thresholdIntensityU", ",", 
      RowBox[{"mMin", "=", "6"}], ",", 
      RowBox[{"mMax", "=", "40"}], ",", "constraints", ",", "solution", ",", 
      "extractedSolution", ",", "previousSolution", ",", "sortedSolution", ",",
       "finalSolution", ",", "optVal", ",", " ", 
      RowBox[{"optValSet", "=", 
