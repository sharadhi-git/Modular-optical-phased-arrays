Cell[BoxData[
 RowBox[{
  RowBox[{"myColorFunction", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "z", "}"}], ",", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"z", "<=", 
        RowBox[{"-", "25"}]}], ",", "c0", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "24.5"}]}], ",", "c1", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "24"}]}], ",", "c2", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "23.5"}]}], ",", "c3", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "23"}]}], ",", "c4", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "22.5"}]}], ",", "c5", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "22"}]}], ",", "c6", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "21.5"}]}], ",", "c7", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "21"}]}], ",", "c8", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "20.5"}]}], ",", "c9", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "20"}]}], ",", "c10", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "19.5"}]}], ",", "c11", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "19"}]}], ",", "c12", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "18.5"}]}], ",", "c13", ",", 
       RowBox[{"z", "<=", 
        RowBox[{"-", "18"}]}], ",", "c14", ",", 
       RowBox[{"z", "<=", 
