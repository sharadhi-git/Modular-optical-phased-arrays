Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mmprCal", "[", 
    RowBox[{"radiationXY_", ",", "userLocations_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"relativePowerList", "=", 
        RowBox[{"{", "}"}]}], ",", "i", ",", 
       RowBox[{"beamPrList", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "10"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"beamPrList", "=", 
          RowBox[{"beamPowerForUsers", "[", 
           RowBox[{"radiationXY", ",", "userLocations", ",", 
            RowBox[{"i", "*", 
             SuperscriptBox["10", 
              RowBox[{"-", "3"}]]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"relativePowerList", ",", 
           FractionBox[
            RowBox[{"Min", "[", "beamPrList", "]"}], 
            RowBox[{"Max", "[", "beamPrList", "]"}]]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "relativePowerList"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
