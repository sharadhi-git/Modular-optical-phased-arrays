Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"findPlanarSLL", "[", 
    RowBox[{
    "focalPoints_", ",", "maxBeamVal_", ",", "clusterExcitationPattern_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"locationList", ",", "i", ",", "radiationList", ",", 
       RowBox[{"maxPair", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"maxPairList", "=", 
        RowBox[{"{", "}"}]}], ",", "maxSll", ",", "maxInt", ",", "psll", ",", 
       "psllLocation"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "[", "focalPoints", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"locationList", "=", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"x", ",", "y"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"x", ",", 
                  RowBox[{
                   RowBox[{"focalPoints", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "-", "0.5"}], ",", 
                  RowBox[{
                   RowBox[{"focalPoints", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "+", "0.5"}], ",", 
                  "0.05"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", 
                  RowBox[{
                   RowBox[{"focalPoints", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", "0.5"}], ",", 
                  RowBox[{
                   RowBox[{"focalPoints", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "+", "0.5"}], ",", 
                  "0.05"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"focalPoints", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "-", "0.005"}], "<=",
                  "x", "<=", " ", 
                 RowBox[{
                  RowBox[{"focalPoints", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "+", "0.005"}]}], 
                ")"}], " ", "&&", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"focalPoints", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", "0.005"}], "<=",
                  "y", "<=", " ", 
                 RowBox[{
                  RowBox[{"focalPoints", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "+", "0.005"}]}], 
                ")"}]}], ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"radiationList", " ", "=", 
          RowBox[{"ParallelTable", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"beamFocusingPatternPlanar", "[", 
                  RowBox[{"\[Lambda]d", ",", "\[Lambda]e", ",", 
                   RowBox[{"locationList", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"locationList", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "2"}], "]"}], "]"}], ",", "0.75", ",", 
                   "Dis1", ",", "dis1", ",", "mx1", ",", "my1", ",", "nx1", ",",
                    "ny1", ",", "xMiddle", ",", "yMiddle", ",", 
                   "focalPoints"}], "]"}], "*", "clusterExcitationPattern"}], 
                ",", "2"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"locationList", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", 
                RowBox[{"locationList", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "2"}], "]"}], "]"}]}], "}"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "[", "locationList", "]"}]}], "}"}]}], 
           "]"}]}], ";", " ", "\[IndentingNewLine]", 
         RowBox[{"maxPair", "=", 
          RowBox[{"First", "@", 
           RowBox[{"MaximalBy", "[", 
            RowBox[{"radiationList", ",", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{"First", "[", "#", "]"}], "]"}], "&"}]}], "]"}]}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"maxPairList", ",", "maxPair"}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}], " ", ";", "\[IndentingNewLine]", 
      RowBox[{"maxInt", "=", 
       RowBox[{"Abs", "[", "maxBeamVal", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"maxSll", "=", 
       RowBox[{"First", "@", 
        RowBox[{"MaximalBy", "[", 
         RowBox[{"maxPairList", ",", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"First", "[", "#", "]"}], "]"}], "&"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"psll", "=", 
       RowBox[{"20", "*", 
        RowBox[{"Log10", "[", 
         FractionBox[
          RowBox[{"Abs", "[", 
           RowBox[{"maxSll", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "maxInt"], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"psllLocation", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"maxSll", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"maxSll", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "0.75"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"psll", ",", "psllLocation"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.944690038425663*^9, 3.944690040378073*^9}, {
   3.9446901859470625`*^9, 3.9446901978394146`*^9}, {3.944690676824601*^9, 
